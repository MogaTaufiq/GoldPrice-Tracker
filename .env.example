# Environment Variables — Gold Price Tracker
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# =============================================================
# SUPABASE
# =============================================================

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================
# AUTHENTICATION
# =============================================================

# bcrypt hash of the admin password
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Random secret string for signing JWT tokens (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# =============================================================
# CRON JOB SECURITY
# =============================================================

# Secret header value sent by Vercel Cron to authenticate cron requests
# Set same value in Vercel dashboard under Environment Variables
# Generate with: openssl rand -base64 32
CRON_SECRET=

# =============================================================
# EXTERNAL APIs
# =============================================================

# Antam price API (emas.maulanar.my.id)
# Obtain from: https://emas.maulanar.my.id (create account)
# Leave empty during Phase 1 development — will use dummy data
ANTAM_API_KEY=
ANTAM_API_BASE_URL=https://emas.maulanar.my.id/api

# Yahoo Finance and Frankfurter are FREE — no API key needed

# =============================================================
# EMAIL BACKUP (Resend)
# =============================================================

# API key from https://resend.com (free tier: 3000 emails/month)
RESEND_API_KEY=

# Email address to receive quarterly backup CSV
BACKUP_EMAIL_TO=

# Email address to send FROM (must be verified domain in Resend)
BACKUP_EMAIL_FROM=noreply@yourdomain.com

# =============================================================
# APP CONFIG
# =============================================================

# Application URL (no trailing slash)
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone for display and cron scheduling
TZ=Asia/Jakarta
